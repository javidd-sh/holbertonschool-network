#!/usr/bin/env bash
# Configures local host resolution in /etc/hosts for localhost and facebook.com

temp_hosts=$(mktemp)

sed -e 's/127\.0\.0\.1\(.*localhost\)/127.0.0.2\1/' \
    -e 's/.*facebook\.com.*/8.8.8.8 facebook.com/' /etc/hosts > "$temp_hosts"

if ! grep -q "facebook\.com" "$temp_hosts"; then
    echo "8.8.8.8 facebook.com" >> "$temp_hosts"
fi

cat "$temp_hosts" > /etc/hosts
rm -f "$temp_hosts"
