#!/usr/bin/env bash
# Configures local host resolution in /etc/hosts for localhost and facebook.com

if grep -q "127.0.0.1.*localhost" /etc/hosts; then
    sed -i 's/127\.0\.0\.1\(.*localhost\)/127.0.0.2\1/' /etc/hosts
elif ! grep -q "127.0.0.2.*localhost" /etc/hosts; then
    echo "127.0.0.2 localhost" >> /etc/hosts
fi

if grep -q "facebook\.com" /etc/hosts; then
    sed -i 's/.*facebook\.com/8.8.8.8 facebook.com/' /etc/hosts
else
    echo "8.8.8.8 facebook.com" >> /etc/hosts
fi
